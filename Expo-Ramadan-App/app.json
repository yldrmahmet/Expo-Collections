{
  "expo": {
    "name": "Ramazan Rehberi",
    "slug": "ramazan-rehberi",
    "version": "1.0.1",
    "scheme": "ramazan-rehberi",
    "orientation": "portrait",
    "assetBundlePatterns": ["**/*"],
    "icon": "./assets/acilis-ekrani.png",
    "splash": {
      "image": "./assets/acilis-ekrani.png",
      "resizeMode": "contain",
      "backgroundColor": "#2E7D32"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.Ramazan.2025.iftar.sahur"
    },
    "android": {
      "package": "com.ramazanrehberi.ilk.test",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/acilis-ekrani.png",
        "backgroundColor": "#2E7D32"
      },
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "a514ad0b-5287-4618-96a7-74833bc4d23a"
      },
      "router": {
        "origin": false
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "owner": "yldrmahmet",
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Konum izni ile bulunduğunuz şehri otomatik tespit ediyoruz."
        }
      ],
      "expo-router"
    ]
  }
}
